APP_NAME="Morowali Juara Command Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Gunakan kredensial terdedikasi (bukan root superuser) untuk produksi.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_mjcc
DB_USERNAME=mjcc_app
DB_PASSWORD=

# Hapus komentar jika memakai SQLite untuk pengembangan/testing lokal:
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan di produksi (HTTPS):
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengiriman email verifikasi. Untuk pengembangan lokal tanpa SMTP biarkan
# MAIL_MAILER=log (email ditulis ke log, bukan benar-benar terkirim). Untuk
# produksi gunakan SMTP Gmail:
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=admin.mjcc@gmail.com
#   MAIL_PASSWORD=<Gmail App Password — BUKAN password akun biasa>
#
# MAIL_PASSWORD wajib disuplai lewat environment/secret management, jangan
# pernah dicommit ke repository.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin.mjcc@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Modul Data Publik: menghimpun statistik terbuka dari portal Satu Data Morowali
# (data.morowalikab.go.id) untuk sektor Pendidikan, Kesehatan, dan Keamanan.
# Tidak memerlukan API key — membaca halaman publik yang dirender server.
PUBLIC_DATA_ENABLED=true
PUBLIC_DATA_USER_AGENT="Mozilla/5.0 (compatible; MorowaliJCC/1.0; +https://data.morowalikab.go.id)"
PUBLIC_DATA_HTTP_TIMEOUT=30
PUBLIC_DATA_HTTP_CONNECT_TIMEOUT=10
PUBLIC_DATA_DELAY_MS=200
PUBLIC_DATA_CACHE_TTL=3600
PUBLIC_DATA_SATUDATA_URL=https://data.morowalikab.go.id
PUBLIC_DATA_SATUDATA_MAX_PAGES=85
PUBLIC_DATA_SCHEDULE=03:00

# Modul Data Publik Multi-Source: Pemantauan Data Publik
# Sumber data eksternal untuk Pendidikan, Pemantauan, Kebencanaan, dan APBD

# Anak Tidak Sekolah (ATS) - Kemendikdasmen
PUBLIC_DATA_ATS_URL=https://ats.data.kemendikdasmen.go.id
PUBLIC_DATA_ATS_REGION_CODE=180700
PUBLIC_DATA_ATS_REGION_NAME="Kabupaten Morowali"

# Dapodik - Kemendikdasmen
PUBLIC_DATA_DAPODIK_URL=https://dapo.kemendikdasmen.go.id
PUBLIC_DATA_DAPODIK_REGION_CODE=180700
PUBLIC_DATA_DAPODIK_REGION_NAME="Kabupaten Morowali"

# SP2KP (Harga & Ketersediaan Kebutuhan Pokok) - Kemendag
PUBLIC_DATA_SP2KP_URL=https://sp2kp.kemendag.go.id
PUBLIC_DATA_SP2KP_API_URL=https://api-sp2kp.kemendag.go.id
PUBLIC_DATA_SP2KP_REGION_CODE=7206
PUBLIC_DATA_SP2KP_PROVINCE=72
PUBLIC_DATA_SP2KP_MARKET_ID=606
PUBLIC_DATA_SP2KP_MARKET_NAME="Pasar Rakyat Bungku Tengah"
PUBLIC_DATA_SP2KP_MAX_VARIANTS=6
PUBLIC_DATA_SP2KP_MONTHS_BACK=12

# BPS API (Badan Pusat Statistik)
# Diperlukan APP_ID dari https://webapi.bps.go.id
BPS_APP_ID=
BPS_API_BASE_URL=https://webapi.bps.go.id
BPS_REGION_CODE=7203
BPS_REGION_NAME="Kabupaten Morowali"
BPS_PROVINCE_CODE=72
BPS_MAX_VARS=30
BPS_API_TIMEOUT=30
BPS_API_RETRY=3
BPS_API_RETRY_DELAY=1000

# IRBI (Indeks Risiko Bencana Indonesia) - BNPB
PUBLIC_DATA_IRBI_URL=https://inarisk.bnpb.go.id
PUBLIC_DATA_IRBI_REGION_CODE=72.06
PUBLIC_DATA_IRBI_PROVINCE=72

# Sitaba (Bencana Terkini) - PUPR
PUBLIC_DATA_SITABA_URL=https://sitaba.pu.go.id/bencana-terkini
PUBLIC_DATA_SITABA_API_URL=https://sitaba.pu.go.id
PUBLIC_DATA_SITABA_SEARCH=MOROWALI

# APBD (TKDD) - DJPK Kemenkeu
PUBLIC_DATA_APBD_BASE_URL=https://djpk.kemenkeu.go.id
PUBLIC_DATA_APBD_URL=/portal/data/tkdd
PUBLIC_DATA_APBD_REGION_CODE=72.06
PUBLIC_DATA_APBD_REGION_NAME="Kabupaten Morowali"
PUBLIC_DATA_APBD_PROVINCE=19
PUBLIC_DATA_APBD_PEMDA=06

VITE_APP_NAME="${APP_NAME}"
