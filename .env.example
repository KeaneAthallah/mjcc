APP_NAME="Morowali Juara Command Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Gunakan kredensial terdedikasi (bukan root superuser) untuk produksi.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_mjcc
DB_USERNAME=mjcc_app
DB_PASSWORD=

# Hapus komentar jika memakai SQLite untuk pengembangan/testing lokal:
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan di produksi (HTTPS):
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengiriman email verifikasi. Untuk pengembangan lokal tanpa SMTP biarkan
# MAIL_MAILER=log (email ditulis ke log, bukan benar-benar terkirim). Untuk
# produksi gunakan SMTP Gmail:
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=admin.mjcc@gmail.com
#   MAIL_PASSWORD=<Gmail App Password — BUKAN password akun biasa>
#
# MAIL_PASSWORD wajib disuplai lewat environment/secret management, jangan
# pernah dicommit ke repository.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin.mjcc@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Government Data Crawler (Data Eksternal) ---
# Aktifkan/nonaktifkan seluruh modul crawler.
CRAWLER_ENABLED=true

# Perilaku HTTP (responsible crawling: timeout lembut + jeda antar request).
CRAWLER_HTTP_TIMEOUT=45
CRAWLER_HTTP_CONNECT_TIMEOUT=10
CRAWLER_USER_AGENT=MorowaliJuaraCommandCenterBot/1.0 (+government-data-sync)
CRAWLER_BASE_DELAY_MS=700

# Antrean & jadwal (waktu HH:MM waktu lokal server).
CRAWLER_QUEUE=crawler
CRAWLER_SCHEDULE_ATS=01:00
CRAWLER_SCHEDULE_DAPO=01:30
CRAWLER_SCHEDULE_SP2KP=02:00
CRAWLER_SCHEDULE_BPS=02:30

# Sumber per-sumber (is_active di tabel crawl_sources menang bila idem).
ATS_CRAWLER_ENABLED=true
DAPO_CRAWLER_ENABLED=true
SP2KP_CRAWLER_ENABLED=true
BPS_CRAWLER_ENABLED=true

# Endpoint default sudah diset di config/crawler.php; override bila perlu.
# ATS_BASE_URL=https://dasbor.data.kemendikdasmen.go.id
# DAPO_BASE_URL=https://referensi.data.kemendikdasmen.go.id
# SP2KP_BASE_URL=https://www.bi.go.id/hargapangan

# Kunci API BPS (WAJIB untuk menarik indikator; jangan commit nilai asli).
BPS_API_KEY=
BPS_API_BASE_URL=https://webapi.bps.go.id

VITE_APP_NAME="${APP_NAME}"
